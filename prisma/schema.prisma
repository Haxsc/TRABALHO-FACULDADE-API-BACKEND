// sqlite nao tem enum, entao os campos de status/tipo ficam como String e sao validados na aplicacao.
// valores em dinheiro sao guardados em centavos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Unidade {
  id       Int      @id @default(autoincrement())
  nome     String
  cidade   String
  uf       String
  endereco String
  ehMatriz Boolean  @default(false)
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  usuarios      Usuario[]
  estoques      Estoque[]
  pedidos       Pedido[]
  promocoes     Promocao[]
  movimentacoes MovimentacaoEstoque[]
}

model Usuario {
  id                      Int       @id @default(autoincrement())
  nome                    String
  email                   String    @unique
  senhaHash               String
  telefone                String?
  perfil                  String    @default("CLIENTE")
  unidadeId               Int?
  consentimentoFidelidade Boolean   @default(false)
  ativo                   Boolean   @default(true)
  anonimizadoEm           DateTime?
  criadoEm                DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt

  unidade        Unidade?              @relation(fields: [unidadeId], references: [id])
  pedidos        Pedido[]              @relation("PedidoCliente")
  pedidosCriados Pedido[]              @relation("PedidoCriador")
  consentimentos Consentimento[]
  transacoesFid  TransacaoFidelidade[]
  refreshTokens  RefreshToken[]
  logs           LogAuditoria[]

  @@index([perfil])
}

model Consentimento {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  finalidade   String
  aceito       Boolean
  versaoTermo  String
  canal        String?
  registradoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, finalidade])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Produto {
  id            Int      @id @default(autoincrement())
  nome          String   @unique
  descricao     String?
  categoria     String
  precoCentavos Int
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  estoques      Estoque[]
  itensPedido   ItemPedido[]
  movimentacoes MovimentacaoEstoque[]
}

model Estoque {
  id               Int      @id @default(autoincrement())
  unidadeId        Int
  produtoId        Int
  quantidade       Int      @default(0)
  quantidadeMinima Int      @default(5)
  atualizadoEm     DateTime @updatedAt

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([unidadeId, produtoId])
}

model MovimentacaoEstoque {
  id         Int      @id @default(autoincrement())
  unidadeId  Int
  produtoId  Int
  tipo       String
  quantidade Int
  saldoApos  Int
  motivo     String?
  pedidoId   Int?
  usuarioId  Int?
  criadoEm   DateTime @default(now())

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([unidadeId, produtoId])
}

model Promocao {
  id                  Int      @id @default(autoincrement())
  codigo              String   @unique
  descricao           String
  tipo                String
  valor               Int
  valorMinimoCentavos Int      @default(0)
  unidadeId           Int?
  inicio              DateTime
  fim                 DateTime
  ativa               Boolean  @default(true)

  unidade Unidade? @relation(fields: [unidadeId], references: [id])
  pedidos Pedido[]
}

model Pedido {
  id                     Int      @id @default(autoincrement())
  unidadeId              Int
  clienteId              Int?
  criadoPorId            Int
  canalPedido            String
  status                 String   @default("AGUARDANDO_PAGAMENTO")
  formaPagamento         String
  subtotalCentavos       Int
  descontoPromoCentavos  Int      @default(0)
  descontoPontosCentavos Int      @default(0)
  totalCentavos          Int
  pontosResgatados       Int      @default(0)
  promocaoId             Int?
  observacao             String?
  idempotencyKey         String?  @unique
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  unidade       Unidade                 @relation(fields: [unidadeId], references: [id])
  cliente       Usuario?                @relation("PedidoCliente", fields: [clienteId], references: [id])
  criadoPor     Usuario                 @relation("PedidoCriador", fields: [criadoPorId], references: [id])
  promocao      Promocao?               @relation(fields: [promocaoId], references: [id])
  itens         ItemPedido[]
  pagamentos    Pagamento[]
  historico     HistoricoStatusPedido[]
  movimentacoes MovimentacaoEstoque[]
  transacoesFid TransacaoFidelidade[]

  @@index([canalPedido])
  @@index([status])
  @@index([unidadeId, criadoEm])
}

model ItemPedido {
  id                    Int @id @default(autoincrement())
  pedidoId              Int
  produtoId             Int
  quantidade            Int
  precoUnitarioCentavos Int
  subtotalCentavos      Int

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])
}

model HistoricoStatusPedido {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  statusAnterior String?
  statusNovo     String
  usuarioId      Int?
  motivo         String?
  criadoEm       DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

model Pagamento {
  id                 Int      @id @default(autoincrement())
  pedidoId           Int
  metodo             String
  valorCentavos      Int
  status             String   @default("PENDENTE")
  provedor           String   @default("MOCK_GATEWAY")
  transacaoExternaId String?
  codigoRetorno      String?
  mensagemRetorno    String?
  payloadRetorno     String?
  tentativas         Int      @default(0)
  idempotencyKey     String?  @unique
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
}

model TransacaoFidelidade {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  pedidoId  Int?
  tipo      String
  pontos    Int
  descricao String
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([usuarioId])
}

model LogAuditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  perfil     String?
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?
  ip         String?
  requestId  String?
  criadoEm   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([acao])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
}
